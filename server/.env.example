# Master Admin CMS — Environment Configuration Template
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/master_admin_cms

# Session Security & Cookie Configuration
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters_random
COOKIE_NAME=master_cms_session
COOKIE_MAX_AGE_DAYS=1

# CORS & Upload Limits
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=35
