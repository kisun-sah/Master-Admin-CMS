{
  "name": "master-admin-cms",
  "version": "1.0.0",
  "description": "Master Admin CMS — Universal MERN Architecture",
  "scripts": {
    "dev": "npx concurrently -n \"SERVER,FRONTEND\" -c \"cyan,magenta\" \"npm run server:dev\" \"npm run frontend\"",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "frontend": "npm run dev --prefix frontend",
    "frontend:build": "npm run build --prefix frontend",
    "build": "npm run frontend:build",
    "seed": "npm run seed --prefix server",
    "test:server": "npm test --prefix server"
  },
  "keywords": [
    "cms",
    "mern",
    "admin-panel",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
