{
  "name": "master-admin-cms",
  "version": "1.0.0",
  "description": "Master Admin CMS — Universal MERN Architecture",
  "scripts": {
    "dev": "concurrently -n \"SERVER,ADMIN,PUBLIC\" -c \"cyan,magenta,blue\" \"npm run server:dev\" \"npm run admin\" \"npm run public\"",
    "start": "concurrently -n \"SERVER,ADMIN,PUBLIC\" -c \"cyan,magenta,blue\" \"npm run server\" \"npm run admin\" \"npm run public\"",
    "server": "npm start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "admin": "npm run dev --prefix admin",
    "admin:build": "npm run build --prefix admin",
    "public": "npm run dev --prefix public",
    "public:build": "npm run build --prefix public",
    "client": "npm run dev --prefix admin",
    "build:client": "npm run build --prefix admin",
    "frontend": "npm run dev --prefix public",
    "build:frontend": "npm run build --prefix public",
    "seed": "npm run seed --prefix server",
    "test:server": "npm test --prefix server"
  },
  "keywords": [
    "cms",
    "mern",
    "admin-panel",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
